# copy to .env and fill in - never commit .env
MAUSAM_DB=/data/mausam.db
MAUSAM_API_KEY=change-me-long-random
# Presentation deployments only: enables public simulator controls and demo bootstrap.
MAUSAM_DEMO_MODE=false
ACCUWEATHER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SESSION_SECRET=replace-with-a-long-random-secret
# Email alerts (SMTP; for Gmail use an app password, never your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMS alerts
SMS_PROVIDER=dryrun
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
STALE_MINUTES=30
MAX_NODE_DISTANCE_KM=30
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=ingest
MQTT_PASSWORD=change-me
# bot
TELEGRAM_TOKEN=123456:from-BotFather
API_BASE_URL=http://api:8000
BOT_DB=/data/bot.db
